# Copy to deploy/.env. Docker Compose reads a comment after a value as part of the value,
# so keep comments on their own lines.

# Required
POSTGRES_PASSWORD=change-me
# Generate with: docker run --rm ghcr.io/evanl666/keel secret
KEEL_SECRET_KEY=

# Image tag to run (0.2 follows 0.2.x patch releases). Pin 0.2.0 to upgrade only on purpose.
KEEL_VERSION=0.2

# Optional: set here or in the setup wizard (env wins)
KEEL_BASE_URL=http://localhost:8420
# anthropic | openai | azure_openai | ollama
KEEL_MODEL_PROVIDER=
KEEL_MODEL_NAME=
KEEL_MODEL_API_KEY=
KEEL_SLACK_BOT_TOKEN=
KEEL_SLACK_APP_TOKEN=
KEEL_GITHUB_TOKEN=
KEEL_OIDC_ISSUER=
KEEL_OIDC_CLIENT_ID=
KEEL_OIDC_CLIENT_SECRET=
KEEL_OIDC_ADMIN_GROUP=
# Claim that lists the user's groups (map groups to teams on each team's Settings page)
KEEL_OIDC_GROUPS_CLAIM=groups
# GitHub: webhooks (set a secret) or polling every 2 minutes (default when no secret): auto | on | off
KEEL_GITHUB_WEBHOOK_SECRET=
KEEL_GITHUB_POLL=auto
# Delete audit rows older than this many days (0 keeps them forever)
KEEL_AUDIT_RETENTION_DAYS=0
KEEL_RUNNER_TOKEN=
